# SlimeWire routing (Cloudflare Pages / any _redirects-aware proxy).
# The homepage and terminal are separate documents. Keep old-app aliases and referral
# links working. NOTE: no /api/* rule here on purpose — the existing API proxy is left untouched.
/               /home                  200
/classic        /old.html              200
/old            /old.html              200
/old/*          /old.html              200
/reference      /old.html              200
/archive        /old.html              200
/r/*            /?ref=:splat           302
# X/t.co links created before the backend-host fix still point at www.slimewire.org/x/.... Forward them
# to the Node service that owns the private lookup and signed Trade Pad handoff instead of SPA-falling home.
/x/*            https://app.slimewire.org/x/:splat  302
# Dynamic generated-site and rewards slugs must resolve to their dedicated
# static shells on slimewire.org. The browser keeps the original pathname, so
# each shell can read the slug and fetch live data from the backend.
/ca/*           /coin-site.html        200
/coin/*         /coin-site.html        200
/c              /community.html        200
/c/*            /community.html        200
/rewards/*      /partner-rewards.html  200
/launch-coin    /terminal?from=fun#launch 302
# Community management uses the same origin and sign-in session as Wallet.
# Preserve agreement query strings and tab fragments; never put auth in a URL.
/launch/community  https://app.slimewire.org/launch/community  302
/launch/community/ https://app.slimewire.org/launch/community  302
/launch/earnings  https://app.slimewire.org/launch/earnings  302
/launch/earnings/ https://app.slimewire.org/launch/earnings  302
/earnings        https://app.slimewire.org/launch/earnings  302
/left4sol       https://app.slimewire.org/left4sol  302
/left4sol/*     https://app.slimewire.org/left4sol  302
/quick          /fun.html              200
/quick/*        /fun.html              200
# SlimeWallet installs from the branded app origin so it keeps its own PWA
# identity and never gets canonicalized to /fun by Pages' pretty-URL handling.
# ?install=1 opens the install guide after the focused wallet shell renders.
/wallet         https://app.slimewire.org/wallet/?install=1  302
/wallet/        https://app.slimewire.org/wallet/?install=1  302
/wallet/*       https://app.slimewire.org/wallet/?install=1  302
/wallet.html    https://app.slimewire.org/wallet/?install=1  302
# SlimeCash installable PWA lives in its own /cash/ folder (own manifest + service
# worker scope so it installs as a separate app). Assets under /cash/* are real
# files and serve directly — only the bare path needs the shell rewrite.
/cash           /cash/index.html       200
# Pages resolves /terminal to terminal.html natively. Do NOT rewrite that
# exact path to its .html filename: canonicalization redirects it to itself.
# Rewrite aliases to the extension-less URL for the same reason.
/terminal/*     /terminal              200
/portal         /terminal              200
/portal/*       /terminal              200
/connect        /terminal              200
/login          /terminal              200
/account/login  /terminal              200
